<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ============ 顶部状态栏区 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待处理"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvProgressSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/MetaText"
                android:text="0 / 0" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_button_ghost"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="历史记录"
            android:scaleType="centerInside"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="刷新"
            android:scaleType="centerInside"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="设置"
            android:scaleType="centerInside"
            android:padding="11dp" />
    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:progressDrawable="@drawable/progress_line"
        android:max="100"
        android:progress="0" />

    <!-- ============ 卡片区 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvEmptyIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="56sp"
                android:textColor="@color/text_tertiary" />
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="全部处理完了"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/MetaText"
                android:gravity="center"
                android:text="" />
        </LinearLayout>

        <!-- 需要激活模块的提示 -->
        <LinearLayout
            android:id="@+id/layoutNeedSetup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="尚未激活"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvSetupDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:text="需要部署系统守护模块才能读取通知" />
            <Button
                android:id="@+id/btnSetup"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:background="@drawable/bg_button_primary"
                android:text="一键激活"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ 底部操作区（渠道行 + 按钮，整体显隐） ============ -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <!-- ============ 渠道行（渠道名 + 禁用开关） ============ -->
    <LinearLayout
        android:id="@+id/rowChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/bg_channel_row"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChannelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通知渠道"
                style="@style/MetaText" />

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChannelState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            style="@style/MetaText"
            android:text="" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- ============ 操作按钮区 ============ -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <!-- 第一行：主操作 -->
        <LinearLayout
            android:id="@+id/rowPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 第二行：次操作 -->
        <LinearLayout
            android:id="@+id/rowSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

        <!-- 状态提示条：高度固定 22dp，永远占位。
             旧版用 wrap_content + GONE，显隐时高度变化会把上方按钮顶得上下跳动。 -->
        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:text="" />
    </LinearLayout>
</LinearLayout>